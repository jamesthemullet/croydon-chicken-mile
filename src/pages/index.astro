---
import Chicken from "../components/Chicken.astro";
import LeafletMap from "../components/LeafletMap.astro";
import RestaurantCard from "../components/RestaurantCard.astro";
import WheelOfFortune from "../components/WheelOfFortune.astro";
import Layout from "../layouts/Layout.astro";

const restaurants = [
	{
		name: "Poor Boys @ BoxPark",
		tagline: "New Orleans Eatery, Reimagined in Croydon",
		specialty: "Chicken",
		address: "99 George St, Croydon CR0 1LD",
		image: "/images/poor-boys-boxpark.jpg",
		lat: 51.3748115,
		lng: -0.0936025,
	},
	{
		name: "RAPS @ BoxPark",
		tagline:
			"Built for fans of soul food who refuse to choose between health and indulgence.",
		specialty: "Chicken",
		address: "99 George St, Croydon CR0 1LD",
		image: "/images/raps-boxpark.jpg",
		lat: 51.3752515,
		lng: -0.0936025,
	},
	{
		name: "Sam's",
		tagline: "The home of great tasting chicken",
		specialty: "Chicken",
		address: "46 High St, Croydon CR0 1YB",
		image: "/images/sams.jpg",
		badge: "4am close on Fri/Sat",
		lat: 51.3722483,
		lng: -0.1005771,
	},
	{
		name: "Rio's Piri Piri",
		tagline: "Newly refurbed",
		specialty: "Chicken",
		address: "48 High St, Croydon CR0 1YB",
		image: "/images/rios-piri-piri.jpg",
		lat: 51.37228012084961,
		lng: -0.10063029825687408,
	},
	{
		name: "Dave's Hot Chicken",
		tagline: "Upper class fried chicken",
		specialty: "Chicken",
		address: "7, 11 High St, Croydon CR0 1QB",
		lat: 51.37342071533203,
		lng: -0.1003,
	},
	{
		name: "Pepe's",
		tagline: "The home of fresh flame grilled chicken",
		specialty: "Chicken",
		address: "52 George St, Croydon CR0 1PD",
		lat: 51.3738299,
		lng: -0.0976982,
	},
	{
		name: "Popeyes",
		tagline: "All the way from Louisiana...don't forget the cajun gravy",
		specialty: "Chicken",
		address: "43 George St, Croydon CR0 1LB",
		lat: 51.3742851,
		lng: -0.0972591,
	},
	{
		name: "Roosters Piri Piri Croydon",
		tagline: "Fresh, grilled and healthy",
		specialty: "Chicken",
		address: "Unit 13, Norfolk House, Wellesley Rd, Croydon CR0 1LH",
		lat: 51.3746507,
		lng: -0.0967463,
	},
	{
		name: "Chick'n Box",
		tagline: "Hotter than your ex",
		specialty: "Chicken",
		address: "79 George St, Croydon CR0 1LD",
		lat: 51.3745907,
		lng: -0.0948675,
	},
	{
		name: "Chicken Valley Croydon",
		tagline: "Joy in every bite",
		specialty: "Chicken",
		address: "100 High St, Croydon CR0 1ND",
		lat: 51.3702522,
		lng: -0.1001995,
	},
	{
		name: "Chicking Croydon",
		tagline: "It's my choice. It's my chicken.",
		specialty: "Chicken",
		address: "282 High St, Croydon CR0 1NG",
		lat: 51.3683786,
		lng: -0.0996001,
	},
	{
		name: "Rooster King - Croydon",
		tagline: "Sizzling taste.",
		specialty: "Chicken",
		address: "10 S End, Croydon CR0 1DL",
		lat: 51.367038,
		lng: -0.099201,
	},
	{
		name: "Southend Chick-Inn Peri Peri",
		tagline: "Chick -Inn.  Peri - Peri.",
		specialty: "Chicken",
		address: "87 S End, Croydon CR0 1BG",
		lat: 51.36477279663086,
		lng: -0.09874819964170456,
	},
	{
		name: "Perfect Fried Chicken - Croydon",
		tagline: "One of the OGs",
		specialty: "Chicken",
		address: "95a S End, Croydon CR0 1BG",
		lat: 51.364376068115234,
		lng: -0.09878550469875336,
	},
	{
		name: "Chicken Tingz",
		tagline: "Things that are chicken",
		specialty: "Chicken",
		address: "123 S End, Croydon CR0 1BJ",
		lat: 51.3638801574707,
		lng: -0.0985528975725174,
	},
	{
		name: "The Green Dragon",
		tagline: "It's actually a really good pub, but guess what they sell?",
		specialty: "Beer. Also chicken",
		address: "58-60 High St, Croydon CR0 1NA",
		lat: 51.37168884277344,
		lng: -0.10061690211296082,
	},
];

const mapMarkers = restaurants
	.filter((r) => r.lat && r.lng)
	.map((r) => ({
		name: r.name,
		address: r.address,
		lat: r.lat as number,
		lng: r.lng as number,
	}));
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Croydon Chicken Mile",
    "description": "The definitive guide to fried chicken establishments on the Croydon Chicken Mile, from BoxPark down through High Street.",
    "itemListElement": restaurants.map((r, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "FoodEstablishment",
        "name": r.name,
        "description": r.tagline,
        "address": {
          "@type": "PostalAddress",
          "streetAddress": r.address,
          "addressLocality": "Croydon",
          "addressRegion": "London",
          "addressCountry": "GB",
        },
        ...(r.lat && r.lng ? {
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": r.lat,
            "longitude": r.lng,
          }
        } : {}),
      }
    }))
  })} />

  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <span class="nav-logo">🍗 CCM</span>
      <a href="#the-mile">The Mile</a>
      <a href="#about">About</a>
    </div>
  </nav>

  <main>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-bg-stripes" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow">Welcome to</p>
        <h1 class="hero-title">Croydon<br />Chicken<br />Mile</h1>
        <p class="hero-sub">
          The world's most underrated fried chicken destination.<br />
          Yeah, we said it.
        </p>
        <a href="#the-mile" class="cta-btn">Show Me The Birds →</a>
        <button id="oracle-trigger" class="oracle-btn">🎰 Wheel of ChickFortune</button>
      </div>
      <div class="hero-chicken">
        <Chicken size={280} />
        <div class="speech-bubble">
          I live here<br />and I'm<br />delicious.
        </div>
      </div>
    </div>
    <div class="hero-ticker" aria-hidden="true">
      <div class="ticker-track">
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
      </div>
    </div>
  </header>

  <!-- ABOUT -->
  <section id="about" class="about" aria-label="About">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <h2 id="about-heading">A Love Letter to Croydon's Chicken Scene</h2>
          <p>
            They built the Eiffel Tower in Paris. They put a big clock in London.
            Croydon? Croydon built a mile of the finest fried chicken establishments
            on the planet, and somehow nobody's written a guide.
          </p>
          <p>
            Until now.
          </p>
          <p>
            The Croydon Chicken Mile is not a Michelin star affair. It's better than that.
            It's a two-piece and chips at 11pm. It's the crunch you hear three tables over.
            It's the sauce that requires two napkins, minimum.
          </p>
          <p>
            Come for the chicken. Stay because the tram home doesn't run until 6am anyway.
          </p>
        </div>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-number">16</span>
            <span class="stat-label">Chicken Shops</span>
          </div>
          <div class="stat">
            <span class="stat-number">1</span>
            <span class="stat-label">Glorious Mile</span>
          </div>
          <div class="stat">
            <span class="stat-number">∞</span>
            <span class="stat-label">Napkins Required</span>
          </div>
          <div class="stat">
            <span class="stat-number">0</span>
            <span class="stat-label">Regrets</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE MILE -->
  <section id="the-mile" class="the-mile" aria-label="The Mile">
    <div class="container">
      <div class="section-header">
        <h2 id="the-mile-heading" class="section-title">The Mile</h2>
        <p class="section-sub">
          Your definitive guide to Croydon's finest chicken establishments.
        </p>
        <p class="mile-definition">
          From BoxPark down through High Street — as defined by the Croydon Tourist Board.
          There are chicken shops elsewhere. This is <em>the</em> Mile.
        </p>
      </div>
      <div class="restaurant-grid">
        {restaurants.map(r => <RestaurantCard {...r} />)}
      </div>
      <p class="missed-a-shop">Missed a chicken shop? <a href="mailto:deepfried@croydonchickenmile.co.uk?subject=Fried%20Chicken%20Is%20Better%20Than%20Sex">Let us know.</a></p>
      <p class="disclaimer">
        No chickens were harmed in the making of this website. (Some were, however, delicious.)
      </p>
    </div>
  </section>

  <!-- MAP -->
  <section class="map-section" aria-label="Find the Mile">
    <div class="container">
      <h2 id="map-heading">Find the Mile</h2>
      <p class="map-definition">From BoxPark down through High Street. As defined by the Croydon Tourist Board.</p>
      <LeafletMap markers={mapMarkers} center={[51.370, -0.1]} zoom={15} />
    </div>
  </section>

  <WheelOfFortune restaurants={restaurants.map(r => ({ name: r.name, tagline: r.tagline }))} />

  </main>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-left">
        <Chicken size={80} />
      </div>
      <div class="footer-right">
        <p class="footer-title">Croydon Chicken Mile</p>
        <p>Made with 🍗 and genuine civic pride.</p>
        <p class="small-muted">
          Not affiliated with any chicken. All opinions are the author's own and are delicious.
        </p>
        <p class="small-muted">
          Got suggestions to improve the website? Want to tell us about your favourite chicken shop on the Mile? Found a typo? <a href="mailto:deepfried@croydonchickenmile.co.uk?subject=Fried%20Chicken%20Is%20Better%20Than%20Sex">Let us know.</a>
        </p>
        <p class="small-muted">
          This website is a bit of fun. If you are offended, we respectfully suggest you go eat some chick'n, no-chick'n, plant-based chicken, Quorn, or THIS Isn't Chicken — and think about what you've done.
        </p>
        <!-- <p class="small-muted">
          An officially unofficial attraction of the <a href="https://croydon-tourist-board.vercel.app" target="_blank" rel="noopener">Croydon Tourist Board</a>.
        </p> -->
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* NAV */
  nav {
    background: var(--dark);
    padding: 0.75rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 3px solid var(--yellow);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-logo {
    font-family: 'Bangers', cursive;
    font-size: 1.4rem;
    color: var(--yellow);
    letter-spacing: 0.1em;
    margin-right: auto;
  }

  nav a {
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--yellow);
  }

  /* HERO */
  .hero {
    background: var(--red);
    position: relative;
    overflow: hidden;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
  }

  .hero-bg-stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 40px,
      rgba(0,0,0,0.06) 40px,
      rgba(0,0,0,0.06) 80px
    );
    pointer-events: none;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex: 1;
    padding: 4rem 2rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-text {
    flex: 1;
    max-width: 520px;
  }

  .hero-eyebrow {
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--yellow);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
    color: var(--yellow);
    text-shadow:
      4px 4px 0 var(--dark),
      -2px -2px 0 var(--red-dark);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: 1.2rem;
    color: var(--yellow-light);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: var(--yellow);
    color: var(--dark);
    font-family: 'Bangers', cursive;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.7rem 2rem;
    border: 3px solid var(--dark);
    border-radius: 8px;
    box-shadow: 5px 5px 0 var(--dark);
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .cta-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--dark);
  }

  .oracle-btn {
    display: inline-block;
    background: var(--red);
    color: var(--white);
    font-family: 'Bangers', cursive;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    padding: 0.7rem 2rem;
    border: 3px solid var(--dark);
    border-radius: 8px;
    box-shadow: 5px 5px 0 var(--dark);
    transition: transform 0.12s, box-shadow 0.12s;
    cursor: pointer;
    margin-top: 0.5rem;
  }

  .oracle-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--dark);
  }

  .hero-chicken {
    position: relative;
    flex-shrink: 0;
    animation: bob 3s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .speech-bubble {
    position: absolute;
    top: -10px;
    right: -110px;
    background: white;
    color: var(--dark);
    font-weight: 900;
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    border: 3px solid var(--dark);
    width: 110px;
    text-align: center;
  }

  .speech-bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    border: 7px solid transparent;
    border-right-color: var(--dark);
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    left: -9px;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-right-color: white;
  }

  /* TICKER */
  .hero-ticker {
    background: var(--yellow);
    color: var(--dark);
    font-family: 'Bangers', cursive;
    font-size: 1rem;
    letter-spacing: 0.1em;
    padding: 0.6rem 0;
    overflow: hidden;
    border-top: 3px solid var(--dark);
  }

  .ticker-track {
    display: inline-block;
    white-space: nowrap;
    animation: ticker 25s linear infinite;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ABOUT */
  .about {
    padding: 5rem 1.5rem;
    background: var(--dark);
    color: var(--cream);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    font-size: 3rem;
    color: var(--yellow);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .about-text p {
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 1rem;
    color: #EEE;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .stat {
    background: var(--red);
    border: 3px solid var(--yellow);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 5px 5px 0 var(--yellow);
  }

  .stat-number {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: 3.5rem;
    color: var(--yellow);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  /* THE MILE */
  .the-mile {
    padding: 5rem 1.5rem;
    background: var(--cream);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--red);
    text-shadow: 4px 4px 0 var(--dark);
    margin-bottom: 0.75rem;
  }

  .section-sub {
    font-size: 1.1rem;
    color: var(--brown);
    max-width: 500px;
    margin: 0 auto 1rem;
    line-height: 1.6;
  }

  .mile-definition {
    font-size: 0.95rem;
    color: var(--brown);
    max-width: 480px;
    margin: 0 auto 1.25rem;
    line-height: 1.6;
    font-style: italic;
  }

  .restaurant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .missed-a-shop {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.95rem;
  }

  .missed-a-shop a {
    color: var(--red-dark);
    text-decoration: underline;
  }

  .missed-a-shop a:hover {
    text-decoration: underline;
  }

  .disclaimer {
    text-align: center;
    font-size: 0.78rem;
    color: var(--brown);
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* MAP */
  .map-section {
    padding: 4rem 1.5rem;
    background: var(--yellow);
    border-top: 4px solid var(--dark);
    border-bottom: 4px solid var(--dark);
  }

  .map-section h2 {
    font-size: 3rem;
    color: var(--dark);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .map-definition {
    text-align: center;
    font-size: 0.95rem;
    color: var(--brown);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  /* FOOTER */
  footer {
    background: var(--dark);
    padding: 3rem 1.5rem;
    border-top: 4px solid var(--yellow);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-right {
    flex: 1;
  }

  .footer-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--yellow);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  footer p {
    color: var(--cream);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .small-muted {
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  footer .small-muted a {
    color: var(--yellow);
    opacity: 1;
    text-decoration: underline;
  }

  footer .small-muted a:hover {
    text-decoration: underline;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
      padding-top: 3rem;
    }

    .speech-bubble {
      position: static;
      margin-top: 1rem;
      width: auto;
    }

    .speech-bubble::before,
    .speech-bubble::after {
      display: none;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
