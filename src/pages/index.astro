---
import Chicken from '../components/Chicken.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import Layout from '../layouts/Layout.astro';

const restaurants = [
  {
    name: "Placeholder Chicken Co.",
    tagline: "Better than your mum's",
    specialty: "Two-piece & chips",
    address: "1 High Street, Croydon CR0 1AA",
    rating: 5,
    mustTry: "The Legendary Box Meal",
    badge: "LEGENDARY"
  },
  {
    name: "Wing King Croydon",
    tagline: "We put the wing in winning",
    specialty: "Buffalo wings, 12 flavours",
    address: "23 Church Street, Croydon CR0 1RH",
    rating: 4,
    mustTry: "Dirty Dozen Wing Bucket",
    badge: "FAN FAVOURITE"
  },
  {
    name: "Golden Cluck",
    tagline: "Since 1987. Still cracking.",
    specialty: "Old-school Southern fry",
    address: "77 London Road, Croydon CR0 2TB",
    rating: 5,
    mustTry: "The Original Fillet Burger",
    badge: "EST. 1987"
  },
  {
    name: "Cluckmaster General",
    tagline: "Resistance is futile",
    specialty: "Nashville hot chicken",
    address: "12 Wellesley Road, Croydon CR0 2AD",
    rating: 4,
    mustTry: "Nuclear Hot Sandwich"
  },
  {
    name: "Peri Peri Palace",
    tagline: "The heat is on",
    specialty: "Spiced whole chickens",
    address: "56 North End, Croydon CR0 1TH",
    rating: 4,
    mustTry: "Half Chicken Extra Hot"
  },
  {
    name: "Crunch & Co.",
    tagline: "Maximum crunch guaranteed",
    specialty: "Double-battered strips",
    address: "99 George Street, Croydon CR0 1PB",
    rating: 3,
    mustTry: "The Strip Stack"
  },
  {
    name: "Midnight Cluck",
    tagline: "Open when you need us most",
    specialty: "Late-night loaded fries",
    address: "34 Southbridge Road, Croydon CR0 1AF",
    rating: 4,
    mustTry: "Loaded Chicken Cheese Fries",
    badge: "OPEN LATE"
  },
  {
    name: "The Boneless Wonder",
    tagline: "No bones, no drama",
    specialty: "Tenders & dips",
    address: "8 Surrey Street, Croydon CR0 1RG",
    rating: 3,
    mustTry: "The Wonder Box (6 tenders)"
  }
];
---

<Layout>
  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <span class="nav-logo">🍗 CCM</span>
      <a href="#the-mile">The Mile</a>
      <a href="#about">About</a>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-bg-stripes" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow">Welcome to</p>
        <h1 class="hero-title">Croydon<br />Chicken<br />Mile</h1>
        <p class="hero-sub">
          The world's most underrated fried chicken destination.<br />
          Yeah, we said it.
        </p>
        <a href="#the-mile" class="cta-btn">Show Me The Birds →</a>
      </div>
      <div class="hero-chicken">
        <Chicken size={280} />
        <div class="speech-bubble">
          I live here<br />and I'm<br />delicious.
        </div>
      </div>
    </div>
    <div class="hero-ticker" aria-hidden="true">
      <div class="ticker-track">
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
        🍗 CROYDON &nbsp;·&nbsp; THE CHICKEN CAPITAL OF SOUTH LONDON &nbsp;·&nbsp;
        🌶 SPICY &nbsp;·&nbsp; CRISPY &nbsp;·&nbsp; LEGENDARY &nbsp;·&nbsp;
      </div>
    </div>
  </header>

  <!-- ABOUT -->
  <section id="about" class="about">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <h2>A Love Letter to Croydon's Chicken Scene</h2>
          <p>
            They built the Eiffel Tower in Paris. They put a big clock in London.
            Croydon? Croydon built a mile of the finest fried chicken establishments
            on the planet, and somehow nobody's written a guide.
          </p>
          <p>
            Until now.
          </p>
          <p>
            The Croydon Chicken Mile is not a Michelin star affair. It's better than that.
            It's a two-piece and chips at 11pm. It's the crunch you hear three tables over.
            It's the sauce that requires two napkins, minimum.
          </p>
          <p>
            Come for the chicken. Stay because the tram home doesn't run until 6am anyway.
          </p>
        </div>
        <div class="about-stats">
          <div class="stat">
            <span class="stat-number">30+</span>
            <span class="stat-label">Chicken Shops</span>
          </div>
          <div class="stat">
            <span class="stat-number">1</span>
            <span class="stat-label">Glorious Mile</span>
          </div>
          <div class="stat">
            <span class="stat-number">∞</span>
            <span class="stat-label">Napkins Required</span>
          </div>
          <div class="stat">
            <span class="stat-number">0</span>
            <span class="stat-label">Regrets</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE MILE -->
  <section id="the-mile" class="the-mile">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">The Mile</h2>
        <p class="section-sub">
          Your definitive guide to Croydon's finest chicken establishments.
          Rated in drumsticks, obviously.
        </p>
        <div class="drumstick-key">
          <span>🍗🍗🍗🍗🍗 = Life changing &nbsp;&nbsp; 🍗🍗🍗 = Solid outing &nbsp;&nbsp; 🍗 = Still better than a salad</span>
        </div>
      </div>
      <div class="restaurant-grid">
        {restaurants.map(r => <RestaurantCard {...r} />)}
      </div>
      <p class="disclaimer">
        * Restaurant details are placeholders — replace with real names, addresses, and opinions.
        No chickens were harmed in the making of this website. (Some were, however, delicious.)
      </p>
    </div>
  </section>

  <!-- MAP PLACEHOLDER -->
  <section class="map-section">
    <div class="container">
      <h2>Find the Mile</h2>
      <div class="map-placeholder">
        <span class="map-icon">🗺️</span>
        <p><strong>Drop a Google Maps embed here</strong></p>
        <p>Centre on: Croydon High Street / North End, CR0</p>
        <p style="font-size:0.8rem; opacity: 0.6; margin-top: 0.5rem;">
          &lt;iframe src="https://maps.google.com/..." /&gt;
        </p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-left">
        <Chicken size={80} />
      </div>
      <div class="footer-right">
        <p class="footer-title">Croydon Chicken Mile</p>
        <p>Made with 🍗 and genuine civic pride.</p>
        <p style="font-size: 0.8rem; opacity: 0.6; margin-top: 0.5rem;">
          Not affiliated with any chicken. All opinions are the author's own and are delicious.
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* NAV */
  nav {
    background: var(--dark);
    padding: 0.75rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 3px solid var(--yellow);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-logo {
    font-family: 'Bangers', cursive;
    font-size: 1.4rem;
    color: var(--yellow);
    letter-spacing: 0.1em;
    margin-right: auto;
  }

  nav a {
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  nav a:hover {
    color: var(--yellow);
  }

  /* HERO */
  .hero {
    background: var(--red);
    position: relative;
    overflow: hidden;
    min-height: 92vh;
    display: flex;
    flex-direction: column;
  }

  .hero-bg-stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 40px,
      rgba(0,0,0,0.06) 40px,
      rgba(0,0,0,0.06) 80px
    );
    pointer-events: none;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
    flex: 1;
    padding: 4rem 2rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-text {
    flex: 1;
    max-width: 520px;
  }

  .hero-eyebrow {
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--yellow);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
    color: var(--yellow);
    text-shadow:
      4px 4px 0 var(--dark),
      -2px -2px 0 var(--red-dark);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: 1.2rem;
    color: var(--yellow-light);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .cta-btn {
    display: inline-block;
    background: var(--yellow);
    color: var(--dark);
    font-family: 'Bangers', cursive;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.7rem 2rem;
    border: 3px solid var(--dark);
    border-radius: 8px;
    box-shadow: 5px 5px 0 var(--dark);
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .cta-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 var(--dark);
  }

  .hero-chicken {
    position: relative;
    flex-shrink: 0;
    animation: bob 3s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .speech-bubble {
    position: absolute;
    top: -10px;
    right: -110px;
    background: white;
    color: var(--dark);
    font-weight: 900;
    font-size: 0.9rem;
    line-height: 1.3;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    border: 3px solid var(--dark);
    width: 110px;
    text-align: center;
  }

  .speech-bubble::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    border: 7px solid transparent;
    border-right-color: var(--dark);
  }

  .speech-bubble::after {
    content: '';
    position: absolute;
    left: -9px;
    top: 50%;
    transform: translateY(-50%);
    border: 6px solid transparent;
    border-right-color: white;
  }

  /* TICKER */
  .hero-ticker {
    background: var(--yellow);
    color: var(--dark);
    font-family: 'Bangers', cursive;
    font-size: 1rem;
    letter-spacing: 0.1em;
    padding: 0.6rem 0;
    overflow: hidden;
    border-top: 3px solid var(--dark);
  }

  .ticker-track {
    display: inline-block;
    white-space: nowrap;
    animation: ticker 25s linear infinite;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ABOUT */
  .about {
    padding: 5rem 1.5rem;
    background: var(--dark);
    color: var(--cream);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    font-size: 3rem;
    color: var(--yellow);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .about-text p {
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 1rem;
    color: #EEE;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .stat {
    background: var(--red);
    border: 3px solid var(--yellow);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 5px 5px 0 var(--yellow);
  }

  .stat-number {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: 3.5rem;
    color: var(--yellow);
    line-height: 1;
  }

  .stat-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.3rem;
  }

  /* THE MILE */
  .the-mile {
    padding: 5rem 1.5rem;
    background: var(--cream);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--red);
    text-shadow: 4px 4px 0 var(--dark);
    margin-bottom: 0.75rem;
  }

  .section-sub {
    font-size: 1.1rem;
    color: var(--brown);
    max-width: 500px;
    margin: 0 auto 1rem;
    line-height: 1.6;
  }

  .drumstick-key {
    font-size: 0.8rem;
    color: #888;
    background: white;
    border: 2px dashed #ddd;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    display: inline-block;
  }

  .restaurant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .disclaimer {
    text-align: center;
    font-size: 0.78rem;
    color: #999;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* MAP */
  .map-section {
    padding: 4rem 1.5rem;
    background: var(--yellow);
    border-top: 4px solid var(--dark);
    border-bottom: 4px solid var(--dark);
  }

  .map-section h2 {
    font-size: 3rem;
    color: var(--dark);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .map-placeholder {
    background: rgba(0,0,0,0.08);
    border: 3px dashed var(--dark);
    border-radius: 16px;
    height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    color: var(--brown);
  }

  .map-icon {
    font-size: 3rem;
  }

  /* FOOTER */
  footer {
    background: var(--dark);
    padding: 3rem 1.5rem;
    border-top: 4px solid var(--yellow);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .footer-right {
    flex: 1;
  }

  .footer-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--yellow);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  footer p {
    color: var(--cream);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
      padding-top: 3rem;
    }

    .speech-bubble {
      position: static;
      margin-top: 1rem;
      width: auto;
    }

    .speech-bubble::before,
    .speech-bubble::after {
      display: none;
    }

    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
