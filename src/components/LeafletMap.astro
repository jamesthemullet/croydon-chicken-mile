---
interface Marker {
	name: string;
	address: string;
	lat: number;
	lng: number;
}

interface Props {
	markers?: Marker[];
	center?: [number, number];
	zoom?: number;
}

const { markers = [], center = [51.3749, -0.0991], zoom = 15 } = Astro.props;
---

<div
	id="chicken-map"
	data-markers={JSON.stringify(markers)}
	data-center={JSON.stringify(center)}
	data-zoom={zoom}
></div>

<script>
	import L from "leaflet";
	import "leaflet/dist/leaflet.css";

	const el = document.getElementById("chicken-map") as HTMLElement;

	function initMap() {
		const markers = JSON.parse(el.dataset.markers ?? "[]");
		const center = JSON.parse(el.dataset.center ?? "[51.3749,-0.0991]");
		const zoom = parseInt(el.dataset.zoom ?? "15");

		const map = L.map(el).setView(center, zoom);
		map.invalidateSize();

		L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
			attribution:
				'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
			maxZoom: 19,
		}).addTo(map);

		const icon = L.divIcon({
			html: "🍗",
			className: "ccm-marker",
			iconSize: [32, 32],
			iconAnchor: [16, 16],
			popupAnchor: [0, -18],
		});

		for (const { name, address, lat, lng } of markers) {
			const popup = document.createElement("div");
			const nameEl = document.createElement("strong");
			nameEl.textContent = name;
			const br = document.createElement("br");
			const addrEl = document.createElement("span");
			addrEl.textContent = address;
			popup.appendChild(nameEl);
			popup.appendChild(br);
			popup.appendChild(addrEl);

			L.marker([lat, lng], { icon })
				.addTo(map)
				.bindPopup(popup);
		}
	}

	const observer = new IntersectionObserver((entries, obs) => {
		if (entries[0].isIntersecting) {
			obs.disconnect();
			initMap();
		}
	}, { rootMargin: '200px' });
	observer.observe(el);
</script>

<style>
	#chicken-map {
		height: 560px;
		border-radius: 12px;
		border: 3px solid var(--dark);
		box-shadow: 6px 6px 0 var(--dark);
	}

	:global(.ccm-marker) {
		font-size: 1.6rem;
		line-height: 1;
		text-align: center;
		background: none !important;
		border: none !important;
	}

	:global(.leaflet-popup-content strong) {
		font-family: "Bangers", cursive;
		font-size: 1.1rem;
		letter-spacing: 0.04em;
		color: #b01808;
	}
</style>
