---
import type { Restaurant } from "../types";

interface Props {
	restaurants: Pick<Restaurant, "name" | "tagline">[];
}

const { restaurants } = Astro.props;
---

<div id="oracle-modal" class="modal-overlay" hidden aria-modal="true" role="dialog" aria-labelledby="oracle-title">
  <div class="modal-inner">
    <button class="modal-close" aria-label="Close">✕</button>
    <h2 id="oracle-title" class="modal-title">Wheel of ChickFortune</h2>
    <div class="wheel-wrap">
      <canvas id="wheel-canvas" width="400" height="400"></canvas>
    </div>
    <button id="spin-btn" class="spin-btn">🍗 SPIN THE WHEEL</button>
    <div id="result-card" class="result-card" aria-live="polite" hidden>
      <p class="oracle-decree">Wheel of ChickFortune has spoken:</p>
      <p id="result-name" class="result-name"></p>
      <p id="result-tagline" class="result-tagline"></p>
    </div>
  </div>
</div>

<script type="application/json" id="wheel-data" is:inline set:html={JSON.stringify(restaurants)}></script>

<script>
  import type { Restaurant } from "../types";
  import { getChild, getEl } from "../lib/dom";
  import {
    computeTargetAngle,
    drawWheel,
    formatResultTagline,
    pickWinnerIndex,
  } from "../lib/wheel";

  type WheelRestaurant = Pick<Restaurant, "name" | "tagline">;

  const restaurants: WheelRestaurant[] = JSON.parse(
    getEl<HTMLScriptElement>('wheel-data').textContent ?? '[]'
  );
  const canvas = getEl<HTMLCanvasElement>('wheel-canvas');
  const ctx2d = canvas.getContext('2d');
  if (!ctx2d) {
    throw new Error('Expected a 2d canvas context to be available');
  }
  const ctx: CanvasRenderingContext2D = ctx2d;
  const spinBtn = getEl<HTMLButtonElement>('spin-btn');
  const resultCard = getEl('result-card');
  const resultName = getEl('result-name');
  const resultTagline = getEl('result-tagline');
  const modal = getEl('oracle-modal');
  const closeBtn = getChild(modal, '.modal-close');
  const oracleTrigger = document.getElementById('oracle-trigger') as HTMLElement | null;
  let lastFocused: HTMLElement | null = null;

  function getFocusableElements(): HTMLElement[] {
    return Array.from(
      modal.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      ),
    ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
  }

  function openModal() {
    lastFocused = document.activeElement as HTMLElement | null;
    modal.hidden = false;
    drawWheel(ctx, canvas, restaurants, angle);
    closeBtn.focus();
  }

  function closeModal() {
    modal.hidden = true;
    (lastFocused ?? oracleTrigger)?.focus();
  }

  modal.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || modal.hidden) return;

    const focusable = getFocusableElements();
    if (focusable.length === 0) return;

    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  const N = restaurants.length;

  let angle = 0;
  let isSpinning = false;

  function showResult(restaurant: WheelRestaurant) {
    resultName.textContent = restaurant.name;
    resultTagline.textContent = formatResultTagline(restaurant.tagline);
    resultCard.hidden = false;
  }

  function spin() {
    if (isSpinning) return;
    isSpinning = true;
    spinBtn.disabled = true;
    resultCard.hidden = true;

    const winnerIdx = pickWinnerIndex(N);
    const targetAngle = computeTargetAngle(angle, winnerIdx, N);

    const duration = 4500;
    const startAngle = angle;
    const startTime = performance.now();

    function frame(now: number) {
      const t = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      angle = startAngle + (targetAngle - startAngle) * eased;
      drawWheel(ctx, canvas, restaurants, angle);

      if (t < 1) {
        requestAnimationFrame(frame);
      } else {
        angle = targetAngle;
        isSpinning = false;
        spinBtn.disabled = false;
        showResult(restaurants[winnerIdx]);
      }
    }

    requestAnimationFrame(frame);
  }

  spinBtn.addEventListener('click', spin);

  closeBtn.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  oracleTrigger?.addEventListener('click', openModal);

  drawWheel(ctx, canvas, restaurants, angle);
</script>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(28, 10, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 1rem;
  }

  .modal-overlay[hidden] {
    display: none;
  }

  .modal-inner {
    background: var(--cream);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    max-width: 480px;
    width: 100%;
    position: relative;
    text-align: center;
    border: 3px solid var(--brown);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--brown);
    line-height: 1;
    padding: 0.25rem 0.4rem;
    border-radius: 0.25rem;
  }

  .modal-close:hover {
    color: var(--red);
    background: rgba(0, 0, 0, 0.06);
  }

  .modal-title {
    font-family: 'Bangers', cursive;
    font-size: 2rem;
    color: var(--red);
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .wheel-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  #wheel-canvas {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .spin-btn {
    font-family: 'Bangers', cursive;
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    background: var(--red);
    color: var(--white);
    border: none;
    border-radius: 0.5rem;
    padding: 0.6rem 2rem;
    cursor: pointer;
    transition:
      background 0.15s,
      transform 0.1s,
      box-shadow 0.1s;
    box-shadow: 0 4px 0 var(--red-dark);
  }

  .spin-btn:hover:not(:disabled) {
    background: var(--red-dark);
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--red-dark);
  }

  .spin-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .result-card {
    margin-top: 1.25rem;
    padding: 1.1rem 1rem;
    background: var(--brown);
    color: var(--cream);
    border-radius: 0.75rem;
    animation: pop-in 0.3s ease;
  }

  @keyframes pop-in {
    from {
      transform: scale(0.85);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .oracle-decree {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.75;
    margin-bottom: 0.3rem;
  }

  .result-name {
    font-family: 'Bangers', cursive;
    font-size: 1.8rem;
    color: var(--yellow);
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
  }

  .result-tagline {
    font-style: italic;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    opacity: 0.9;
  }


</style>
